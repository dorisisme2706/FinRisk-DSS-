# Copy to app/.env (never commit app/.env). Values below are placeholders only.
FINRISK_DATABASE_URL=postgresql://finrisk_api_login:CHANGE_ME@127.0.0.1:5432/finrisk_app_db?sslmode=prefer
FINRISK_DB_SCHEMA=finrisk_app
FINRISK_DB_CONNECT_TIMEOUT=5
FINRISK_DB_APP_NAME=finrisk-dss-local
# PII_ENCRYPTION_KEY must be provided through a secret manager/Windows protected store.
# Do not put production key material in this file or source control.
FINRISK_PII_KEY_REFERENCE=SET_IN_WINDOWS_SECRET_STORE
